{
  "info": {
    "_postman_id": "fab26c36-4fa7-47e6-be44-a6a55673f01b",
    "name": "Wufoo REST Comments Login API",
    "description": "The Wufoo REST API v3 provides programmatic read and write access to a Wufoo\naccount: Forms, Fields, Entries, Reports, Widgets, Comments, Users, and\nWebhooks. Every request is per-subdomain and authenticates with the account\nAPI key over HTTP Basic Auth. Endpoints support `.json` or `.xml` response\nformats by appending the extension to the URL.\n\n\nContact Support:\n Name: Wufoo Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:35:04.000Z",
    "updatedAt": "2026-07-28T03:35:04.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-fab26c36-4fa7-47e6-be44-a6a55673f01b"
  },
  "item": [
    {
      "name": "login.{format}",
      "item": [
        {
          "name": "Exchange Credentials For API Key",
          "id": "264e2f28-8f87-4610-8e4f-6fdee9a6e592",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "description": "(Required) ",
                  "key": "email",
                  "value": "<email>"
                },
                {
                  "description": "(Required) ",
                  "key": "password",
                  "value": "<string>"
