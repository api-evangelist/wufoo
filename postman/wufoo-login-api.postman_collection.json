                      "value": "<string>"
                    },
                    {
                      "key": "subdomain",
                      "value": "<string>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/login.{{format}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "login.{{format}}"
                  ]
