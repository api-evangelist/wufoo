              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login.{{format}}"
              ]
            },
            "description": "Builders integrating Wufoo for third-party customers can exchange a user's\nemail/password for that user's API key.\n"
          },
          "response": [
            {
              "id": "a0dfdfed-3ef3-4e9f-81a5-b823660fa98d",
