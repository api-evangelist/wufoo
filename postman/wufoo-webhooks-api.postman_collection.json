    "uid": "35240-1822cfe1-dbe9-4589-bee5-d37a3f414d48"
  },
  "item": [
    {
      "name": "webhooks",
      "item": [
        {
          "name": "{identifier}.{format}",
          "item": [
            {
              "name": "Add Form Webhook",
              "id": "61495594-0456-45bb-b5ea-7d0c4f0be605",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) Subscriber endpoint to POST submissions to.",
                      "key": "url",
                      "value": "<uri>"
                    },
                    {
                      "description": "Shared secret echoed back as `HandshakeKey` in payloads.",
                      "key": "handshakeKey",
                      "value": "<string>"
                    },
                    {
                      "description": "When true, include FormStructure and FieldStructure in payload.",
                      "key": "metadata",
                      "value": "<boolean>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/webhooks/{{identifier}}.{{format}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "webhooks",
                    "{{identifier}}.{{format}}"
                  ]
                },
                "description": "Subscribes a URL to receive webhook POSTs when the form is submitted. Up to 10 per form."
              },
              "response": [
                {
                  "id": "67dab657-6485-49b3-ada1-e55ca2a81c8e",
                  "name": "Webhook subscription created.",
                  "originalRequest": {
                    "method": "PUT",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: basic",
                        "key": "Authorization",
                        "value": "Basic <credentials>"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) Subscriber endpoint to POST submissions to.",
                          "key": "url",
                          "value": "<uri>"
                        },
                        {
                          "description": "Shared secret echoed back as `HandshakeKey` in payloads.",
                          "key": "handshakeKey",
                          "value": "<string>"
                        },
                        {
                          "description": "When true, include FormStructure and FieldStructure in payload.",
                          "key": "metadata",
                          "value": "<boolean>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/webhooks/{{identifier}}.{{format}}",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "webhooks",
                        "{{identifier}}.{{format}}"
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
