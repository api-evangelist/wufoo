{
  "item": [
    {
      "id": "4bd09d65-ce4d-428e-b480-a553fc550f85",
      "name": "Webhooks",
      "description": {
        "content": "Subscribe to and unsubscribe from form submission webhooks.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9b94a976-f72b-4147-b62c-6ad8eac9d97e",
          "name": "Add Form Webhook",
          "request": {
            "name": "Add Form Webhook",
            "description": {
              "content": "Subscribes a URL to receive webhook POSTs when the form is submitted. Up to 10 per form.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhooks",
                "{{identifier}}.{{format}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Wufoo account subdomain.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) Subscriber endpoint to POST submissions to."
                },
                {
                  "disabled": false,
                  "key": "handshakeKey",
                  "value": "<string>",
                  "description": "Shared secret echoed back as `HandshakeKey` in payloads."
                },
                {
                  "disabled": false,
                  "key": "metadata",
                  "value": "<boolean>",
                  "description": "When true, include FormStructure and FieldStructure in payload."
                }
              ]
            }
          },
          "response": [
            {
              "id": "ecb65964-4000-40ae-aa83-bf3a928601c1",
              "name": "Webhook subscription created.",
              "originalRequest": {
                "url": {
                  "path": [
                    "webhooks",
                    "{{identifier}}.{{format}}"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Wufoo account subdomain.",
                      "type": "any",
                      "value": "{{subdomain}}",
                      "key": "subdomain"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "PUT",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Subscriber endpoint to POST submissions to.",
                        "type": "text/plain"
                      },
                      "key": "url",
                      "value": "<uri>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Shared secret echoed back as `HandshakeKey` in payloads.",
                        "type": "text/plain"
                      },
                      "key": "handshakeKey",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "When true, include FormStructure and FieldStructure in payload.",
                        "type": "text/plain"
                      },
                      "key": "metadata",
                      "value": "<boolean>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"WebHookPutResult\": {\n    \"Hash\": \"string\"\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "5c6d81b1-f91d-4896-a55c-bb78cbb463dd",
          "name": "Delete Form Webhook",
          "request": {
            "name": "Delete Form Webhook",
            "description": {
              "content": "Unsubscribes a previously created webhook.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhooks",
                ":identifier",
                "{{hash}}.{{format}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "identifier",
                  "description": "(Required) Form or report hash (preferred) or its title."
                },
                {
                  "description": "Your Wufoo account subdomain.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
          "response": [
            {
              "id": "e58ea389-3388-4992-ab4d-5ade8a97ef7d",
              "name": "Webhook deleted.",
              "originalRequest": {
                "url": {
                  "path": [
                    "webhooks",
                    ":identifier",
                    "{{hash}}.{{format}}"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "identifier",
                      "description": "(Required) Form or report hash (preferred) or its title."
                    },
                    {
                      "description": "Your Wufoo account subdomain.",
                      "type": "any",
                      "value": "{{subdomain}}",
                      "key": "subdomain"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "DELETE",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"WebHookDeleteResult\": 5518\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
