{
  "item": [
    {
      "id": "05d13754-a6ae-49d0-8ffe-3c7adc817272",
      "name": "Login",
      "description": {
        "content": "Exchange credentials for an API key.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fbc2872c-2361-4553-932d-6ca5a7e116c1",
          "name": "Exchange Credentials For API Key",
          "request": {
            "name": "Exchange Credentials For API Key",
            "description": {
              "content": "Builders integrating Wufoo for third-party customers can exchange a user's\nemail/password for that user's API key.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login.{{format}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Wufoo account subdomain.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "integrationKey",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "subdomain",
                  "value": "<string>"
                }
              ]
            }
          },
          "response": [
            {
              "id": "167f1450-64cf-47b6-b438-7783a078b3ea",
              "name": "API key and subdomain for the user.",
              "originalRequest": {
                "url": {
                  "path": [
                    "login.{{format}}"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Wufoo account subdomain.",
                      "type": "any",
                      "value": "{{subdomain}}",
                      "key": "subdomain"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "password",
                      "value": "<password>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "integrationKey",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "key": "subdomain",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"ApiKey\": \"string\",\n  \"Subdomain\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "description": {
        "content": "Your Wufoo account subdomain.",
        "type": "text/plain"
      },
      "type": "any",
      "value": "account",
      "key": "subdomain"
    },
    {
      "type": "string",
      "value": "https://{{subdomain}}.wufoo.com/api/v3",
      "key": "baseUrl"
    },
    {
      "disabled": false,
      "description": {
        "content": "(Required) Response serialization format.",
        "type": "text/plain"
      },
      "type": "any",
      "value": "json",
      "key": "format"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basicAuthUsername}}"
      },
      {
        "key": "password",
        "value": "{{basicAuthPassword}}"
      }
    ]
  },
  "info": {
    "_postman_id": "1868545f-58b5-4439-ae89-638c7ce7fd59",
    "name": "Wufoo REST Comments Login API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Wufoo REST API v3 provides programmatic read and write access to a Wufoo\naccount: Forms, Fields, Entries, Reports, Widgets, Comments, Users, and\nWebhooks. Every request is per-subdomain and authenticates with the account\nAPI key over HTTP Basic Auth. Endpoints support `.json` or `.xml` response\nformats by appending the extension to the URL.\n\n\nContact Support:\n Name: Wufoo Support",
      "type": "text/plain"
    }
  }
}